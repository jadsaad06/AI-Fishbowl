# Backend environment variables for MCP, LLM, STT, and TTS.

# MCP server key for weather/geocoding APIs
Weather_API_KEY="API_KEY_HERE"

# Comma-separated MCP server URLs per fish personality
PINTO_MCP_SERVERS="your-mcp-server"
MIMI_MCP_SERVERS="your-mcp-server"
BONGO_MCP_SERVERS = "http://127.0.0.1:8005/mcp"

# Whether each fish can use all discovered MCP tools
PINTO_ALLOW_ALL = "false"
MIMI_ALLOW_ALL = "False"
BONGO_ALLOW_ALL = "True"

# Music Recommendation API keys 
LASTFM_API_KEY=""
LASTFM_SHARED_SECRET=""

# Auth token for Smithery-hosted MCP servers (if used)
SMITHERY_KEY = "API_KEY_HERE"

# Google Cloud credentials for STT fallback
GOOGLE_APPLICATION_CREDENTIALS="path-to-credentials-json"
GOOGLE_CLOUD_PROJECT="your-google-cloud-project"

# Gemini / LangChain embedding key expected by Google GenAI libs
GOOGLE_API_KEY="YOU_API_KEY"

# RAG loader filter used in backend/src/services/llm/RAG_DB/loaddb.py
PATH_NAME=computer-science

# TTS runtime device selection: cuda or cpu
TTS_DEVICE=cpu

# STT: Mic used for speech to text: Get mic with list_devices.py
MIC_NAME="Macbook"

# Optional test-only overrides used by backend/src/mcp_stack/test/test_guardrails.py
FASTAPI_BASE_URL=ws://127.0.0.1:8000
WS_ORIGIN=http://127.0.0.1:8000
WS_TIMEOUT=60
RUN_WS_TESTS=0