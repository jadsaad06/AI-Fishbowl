# Optional Whisper server overrides used by fishbowl.sh.
# These vars are consumed by fishbowl.sh; current hardware Python scripts
# (VAD.py/mic-input.py) do not directly parse .env.
# If unset, defaults resolve to:
#   WHISPER_ROOT=$HOME/whisper.cpp
#   WHISPER_BIN=$WHISPER_ROOT/build/bin/whisper-server
#   WHISPER_MODEL=$WHISPER_ROOT/models/ggml-base.en.bin

WHISPER_ROOT=
WHISPER_BIN=
WHISPER_MODEL=
